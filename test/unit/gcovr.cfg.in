root=@CMAKE_SOURCE_DIR@/../..

# Exclure tests et build
exclude=.*/test/.*
exclude=.*/tests/.*
exclude=.*/build/.*
exclude=.*/_deps/.*

# Exclure frameworks de test
exclude=.*/doctest/.*
exclude=.*/Catch2/.*
exclude=.*/googletest/.*

cobertura = @CMAKE_BINARY_DIR@/cobertura.xml 
sonarqube = @CMAKE_BINARY_DIR@/sonarqube.xml 
html-details = @CMAKE_BINARY_DIR@/coverage.html 
gcov-executable = @GCOV_EXECUTABLE@
gcov-parallel = yes
